# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demo only: set to "true" to blur all text (show the style, hide the copy).
NEXT_PUBLIC_BLUR_TEXT=false
# Same URL, but read by Edge Functions (Talo redirect, email links, CORS). Set as a
# function secret; every edge secret is listed in supabase/.env.secrets.example.
APP_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────
# From the project's Connect dialog / Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=        # sb_publishable_...  (replaces the legacy anon key)
# Server-side only, never exposed to the browser. Supabase provides it to Edge
# Functions automatically; listed for completeness.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google Calendar (availability) — OPTIONAL ────────────────────────────
# Only the two fields the signer needs (not the whole service-account JSON).
# From the downloaded key JSON: `client_email` and `private_key`.
# Set as Edge Function secrets:
#   supabase secrets set GOOGLE_CLIENT_EMAIL=... GOOGLE_PRIVATE_KEY="...\n..."
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# The calendar the center manages availability in (share it with GOOGLE_CLIENT_EMAIL).
GOOGLE_CALENDAR_ID=

# ─── Email (notifications) — OPTIONAL, via Resend ─────────────────
# _shared/email.ts posts to the Resend HTTP API and no-ops when either of these is
# unset, so the booking flow keeps working without email configured.
# EMAIL_FROM must be a sender on your Resend-verified domain.
# Set as Edge Function secrets:
#   supabase secrets set RESEND_API_KEY=re_... EMAIL_FROM="VULL <hola@tu-dominio>"
RESEND_API_KEY=
EMAIL_FROM=

# Hours, slot length, hold time and notice periods are per sector (table
# `sectors` / `sector_hours`, edited in Admin › Ajustes), NOT here.
# Optional anti-abuse (read by create-booking): max concurrent unconfirmed holds
# per user, and a per-user throttle between bookings (seconds).
MAX_ACTIVE_HOLDS=3
BOOKING_THROTTLE_SECONDS=5

# ─── Security hardening (optional) ─────────────────────────────────────────
# Extra browser origins allowed to call the Edge Functions (comma-separated), in
# addition to APP_URL and localhost. e.g. https://www.vull.com.ar,https://vull.com.ar
CORS_EXTRA_ORIGINS=
# Cloudflare Turnstile — free bot protection for login/OTP. Set the PUBLIC site
# key (browser) here and TURNSTILE_SECRET (Edge/Auth), then enable [auth.captcha]
# in supabase/config.toml. Leave empty to keep captcha off (login works as-is).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ─── Talo (automatic bank transfers) ───────────────────────────────────────
# Dashboard → Usuario → Credenciales. Sandbox accounts are SEPARATE from
# production: create one at https://sandbox.talo.com.ar and set TALO_TEST=true.
# All of these are Edge Function secrets (supabase secrets set ...).
TALO_USER_ID=
TALO_CLIENT_ID=
TALO_CLIENT_SECRET=
# Shared secret added as ?token=... to the webhook URL. REQUIRED — the webhook
# fails closed without it. Talo does not sign webhooks; we re-fetch every payment
# from Talo's API regardless, so this token is a rate-limit gate, not the
# authority. Use a value dedicated to this endpoint (it lands in function logs).
TALO_WEBHOOK_SECRET=
# Shared secret for the talo-reconcile cron (same ?token= pattern, fail-closed).
# Point an external cron at .../functions/v1/talo-reconcile?token=... every ~10 min.
TALO_RECONCILE_TOKEN=
# "true" → https://sandbox-api.talo.com.ar; anything else → production.
TALO_TEST=true
# Minutes the client has to transfer. This is ALSO how long the slot is held:
# the CVU expiry and bookings.hold_expires_at are set to the same instant.
TALO_PAYMENT_MINUTES=30
# Browser flag: shows the "Pagar por transferencia" button. It is the ONLY way
# to pay (ADR 0014: no manual receipt), so it must be true wherever clients pay;
# keep false only until the secrets above are set and the sandbox run in
# docs/adr/0010 has passed.
NEXT_PUBLIC_TALO_ENABLED=false

# ─── Dev mode (NEVER in production) ────────────────────────────────────────
# Edge secret: enables the dev-fake-payment function (also needs TALO_TEST=true).
DEV_MODE=false
# Browser flag: "Dev mode" badge + "Simular pago" button on Talo transfers.
NEXT_PUBLIC_DEV_MODE=false

# ─── WhatsApp ──────────────────────────────────────────────────────────────
# Business number in international format WITHOUT +, used for wa.me deep links.
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=
# Optional inbound WhatsApp Cloud API webhook (whatsapp-webhook function).
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret — required for the inbound POST webhook (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=

# ─── Google Calendar reconciliation cron — OPTIONAL ────────────────────────
# Shared secret added as ?token=... to the calendar-poll function URL, called by an
# external cron. Fail-CLOSED: without it the endpoint rejects every request.
CALENDAR_POLL_TOKEN=

# ─── Web Push (admin notifications) — OPTIONAL ─────────────────────────────
# Generate once with `npx web-push generate-vapid-keys`. The PUBLIC key goes to
# both the browser (NEXT_PUBLIC_) and the Edge Function; the private key + subject
# are Edge Function secrets. Leave empty to keep push off (email alerts still work).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@tu-dominio
