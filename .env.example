# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demo only: set to "true" to blur all text (show the style, hide the copy).
NEXT_PUBLIC_BLUR_TEXT=false
# Same URL, but read by Edge Functions (Mobbex return_url). Set as a function secret.
APP_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────
# From the project's Connect dialog / Settings → API Keys (cloud) or `supabase status` (local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=        # sb_publishable_...  (replaces the legacy anon key)
# Server-side only — never expose to the browser. Used by Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google Calendar (availability) — OPTIONAL ────────────────────────────
# Only the two fields the signer needs (not the whole service-account JSON).
# From the downloaded key JSON: `client_email` and `private_key`.
# Set as Edge Function secrets:
#   supabase secrets set GOOGLE_CLIENT_EMAIL=... GOOGLE_PRIVATE_KEY="...\n..."
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# The calendar the center manages availability in (share it with GOOGLE_CLIENT_EMAIL).
GOOGLE_CALENDAR_ID=

# ─── Email (OTP + booking receipts) — OPTIONAL, via Resend ─────────────────
# _shared/email.ts posts to the Resend HTTP API and no-ops when either of these is
# unset, so the booking flow keeps working without email configured.
# EMAIL_FROM must be a sender on your Resend-verified domain.
# Set as Edge Function secrets:
#   supabase secrets set RESEND_API_KEY=re_... EMAIL_FROM="VULL <hola@tu-dominio>"
RESEND_API_KEY=
EMAIL_FROM=

# Working hours / days / timezone live in the `settings` table (edit in Studio
# or the admin panel), NOT here.
# Optional: minutes a pending booking holds a slot (read by create-booking).
# NOTE: the code default is 20 when unset; docs/booking-invariants.md documents 10 as
# canonical, so set it explicitly rather than relying on the default.
BOOKING_HOLD_MINUTES=10
# Optional anti-abuse (read by create-booking): max concurrent unconfirmed holds
# per user, and a per-user throttle between bookings (seconds).
MAX_ACTIVE_HOLDS=3
BOOKING_THROTTLE_SECONDS=5

# ─── Security hardening (optional) ─────────────────────────────────────────
# Extra browser origins allowed to call the Edge Functions (comma-separated), in
# addition to APP_URL and localhost. e.g. https://www.vull.com.ar,https://vull.com.ar
CORS_EXTRA_ORIGINS=
# Cloudflare Turnstile — free bot protection for login/OTP. Set the PUBLIC site
# key (browser) here and TURNSTILE_SECRET (Edge/Auth), then enable [auth.captcha]
# in supabase/config.toml. Leave empty to keep captcha off (login works as-is).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ─── Mobbex (payments) ─────────────────────────────────────────────────────
# Dev portal: https://mobbex.dev  — sent as x-api-key / x-access-token headers.
MOBBEX_API_KEY=
MOBBEX_ACCESS_TOKEN=
# Shared secret added as ?token=... to the webhook URL to authenticate Mobbex IPNs.
MOBBEX_WEBHOOK_SECRET=
# Set to "true" to use Mobbex sandbox/test mode.
MOBBEX_TEST=false
# Online payments are OFF until the Mobbex merchant account is enabled. While this
# is not "true" the client-side "Pagar online" button is hidden entirely (it would
# only 503) and bank transfer + receipt is the single payment path.
NEXT_PUBLIC_MOBBEX_ENABLED=false

# ─── Manual bank transfer (fallback) ───────────────────────────────────────
# Alias/CBU shown to clients who pay by transfer and upload a receipt.
NEXT_PUBLIC_TRANSFER_ALIAS=

# ─── WhatsApp ──────────────────────────────────────────────────────────────
# Business number in international format WITHOUT +, used for wa.me deep links.
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=
# Phase 3 (WhatsApp Cloud API inbound webhook) — optional for v1.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret — required for the inbound POST webhook (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Google Calendar reconciliation cron — OPTIONAL ────────────────────────
# Shared secret added as ?token=... to the calendar-poll function URL, called by an
# external cron. Fail-CLOSED: without it the endpoint rejects every request.
CALENDAR_POLL_TOKEN=

# ─── Web Push (admin notifications) — OPTIONAL ─────────────────────────────
# Generate once with `npx web-push generate-vapid-keys`. The PUBLIC key goes to
# both the browser (NEXT_PUBLIC_) and the Edge Function; the private key + subject
# are Edge Function secrets. Leave empty to keep push off (email alerts still work).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@tu-dominio
