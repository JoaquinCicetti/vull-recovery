# Every Edge Function secret, by name. The canonical list: no values here, ever.
#
# Set them on the cloud project with `pnpm exec supabase secrets set KEY=value`
# (or from a gitignored env file with --env-file). `scripts/deploy.sh` compares
# this list with `supabase secrets list` and warns about any REQUIRED one that
# is missing (fails instead with --strict). SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY are injected by the platform and not listed.
#
# Everything above the "@optional" line is required in production.

# ─── App ────────────────────────────────────────────────────────────────────
# Site URL: Talo redirect, links in emails, CORS allow-list.
APP_URL=

# ─── Email (Resend, ADR 0008) ───────────────────────────────────────────────
# Without these every email fails and shows on /admin "Avisos no enviados".
RESEND_API_KEY=
# A sender on the Resend-verified domain, e.g. "VULL <hola@vull.com.ar>".
EMAIL_FROM=

# ─── Web Push (npx web-push generate-vapid-keys) ────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:owner@your-domain
VAPID_SUBJECT=

# ─── Talo (ADR 0010; scripts/deploy.sh pushes these from supabase/.env.<mode>)
TALO_USER_ID=
TALO_CLIENT_ID=
TALO_CLIENT_SECRET=
# "true" → sandbox. Must match the deploy mode.
TALO_TEST=
# ?token= of the talo-webhook URL given to Talo. Ours, random, used nowhere else.
TALO_WEBHOOK_SECRET=

# ─── Cron tokens (each gates one ?token= endpoint, fails closed) ────────────
# talo-reconcile, every ~10 min.
TALO_RECONCILE_TOKEN=

# @optional ───────────────────────────────────────────────────────────────────
# notify-dispatch, every ~5 min: retries what the notifications outbox still
# holds. Sends are immediate without it; /admin "Reintentar" covers the rest.
NOTIFY_DISPATCH_TOKEN=
# membership-cycle: NOT needed as a cron. Abono roll, surcharge and release
# are derived lazily on every query (ADR 0011); the endpoint is a manual kick.
MEMBERSHIP_CYCLE_TOKEN=
# "true" enables dev-fake-payment (also needs TALO_TEST=true). deploy.sh sets it.
DEV_MODE=
# Minutes a client has to transfer (default 30); also the slot hold.
TALO_PAYMENT_MINUTES=
# Google Calendar (recovery availability + calendar-poll). Unset = DB only.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
# calendar-poll: manual one-shot sync of Google edits (only with Google).
CALENDAR_POLL_TOKEN=
# WhatsApp inbound webhook (optional phase).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Extra browser origins allowed to call the functions (comma-separated).
CORS_EXTRA_ORIGINS=
# Anti-abuse knobs for create-booking (defaults 3 and 5).
MAX_ACTIVE_HOLDS=
BOOKING_THROTTLE_SECONDS=
# DEV ONLY, local supabase/functions/.env: send mail to Mailpit instead of
# Resend. NEVER set it on the cloud project.
EMAIL_SINK_URL=
